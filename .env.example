# =============================================================================
# Supabase — required only for the Supabase persistence path (Phases 3-4).
# For an Excel-only Phase 1 run, leave these empty.
# =============================================================================

# 1) Project URL. Find it at: Dashboard → Settings → API → Project URL
#    Format: https://abcdefghijkl.supabase.co
SUPABASE_URL=

# 2) Publishable key (new format `sb_publishable_...`, formerly `anon`).
#    Safe to expose on the front-end; the ETL does NOT use it.
SUPABASE_ANON_KEY=

# 3) Secret key (new format `sb_secret_...`, formerly `service_role`).
#    REQUIRED for Phase 1 if you persist to Supabase.
#    Find it at: Dashboard → Settings → API → "Reveal secret key".
#    NEVER expose this on a client-side surface.
SUPABASE_SERVICE_ROLE_KEY=

# 4) Postgres connection string (used by `supabase db push` and heavy queries).
#    Find it at: Dashboard → Settings → Database → Connection string → "URI".
#    Format: postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres
SUPABASE_DB_URL=

# =============================================================================
# External APIs — fill in only when you reach the corresponding phase.
# =============================================================================

# Phase 2 (enrichment) — Gemini API for origin / size / tech-profile / website
# discovery. Get a key at https://aistudio.google.com/apikey (free tier covers
# the first run of ~74 leads with Google Search grounding).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Phase 4 (Casa dos Dados delta + notifications)
CASA_DOS_DADOS_TOKEN=
SLACK_WEBHOOK_URL=
RESEND_API_KEY=

# =============================================================================
# General configuration
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
RECEITA_DUMP_DIR=./data/receita
